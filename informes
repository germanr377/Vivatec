<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vivatec - Informes y Vencimientos</title>
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f9; margin: 0; padding: 20px; color: #333; }
        .container { max-width: 1050px; margin: auto; background: #fff; padding: 25px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,.1); }
        h2 { text-align: center; color: #2c3e50; margin-bottom: 20px; }
        
        /* Panel de filtros */
        .filtros-panel { background: #ecf0f1; padding: 20px; border-radius: 6px; margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end; }
        .form-group { flex: 1; min-width: 200px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; color: #555; font-size: 14px; }
        select, input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 15px; box-sizing: border-box; }
        
        .btn-search { background: #2980b9; color: white; border: none; padding: 10px 20px; font-size: 16px; font-weight: bold; border-radius: 4px; cursor: pointer; height: 42px; }
        .btn-print { background: #27ae60; color: white; border: none; padding: 10px 20px; font-size: 16px; font-weight: bold; border-radius: 4px; cursor: pointer; height: 42px; }

        /* Tabla de resultados */
        .tabla-container { overflow-x: auto; margin-top: 20px; }
        table { width: 100%; border-collapse: collapse; min-width: 850px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; font-size: 14px; }
        th { background-color: #2c3e50; color: white; position: sticky; top: 0; }
        tr:nth-child(even) { background-color: #f9f9f9; }
        tr:hover { background-color: #f1f1f1; }
        
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
        .badge-nuevo { background: #2ecc71; color: white; }
        
        #mensajeEstado { margin-top: 15px; font-weight: bold; color: #e67e22; text-align: center; }

        @media print {
            body * { visibility: hidden; }
            .container, .container * { visibility: visible; }
            .container { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; padding: 0; }
            .filtros-panel, .btn-print, .btn-search { display: none; }
        }
        @media (max-width: 768px) { .filtros-panel { flex-direction: column; } .form-group, .btn-search, .btn-print { width: 100%; } }
    </style>
</head>
<body>

<div class="container">
    <h2>📈 Informes de Vencimientos - Vivatec</h2>

    <!-- PANEL DE FILTROS POR FECHAS Y CLIENTE -->
    <div class="filtros-panel">
        <div class="form-group">
            <label for="filtroCliente">Cliente (Opcional):</label>
            <select id="filtroCliente">
                <option value="">-- Todos los clientes --</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tipoFecha">Tipo de Vencimiento:</label>
            <select id="tipoFecha">
                <option value="vto_carga">Vencimiento de Carga</option>
                <option value="vto_prueb_hidr">Vencimiento Prueba Hidráulica (P.H.)</option>
            </select>
        </div>
        <div class="form-group">
            <label for="fechaDesde">Desde la fecha:</label>
            <input type="date" id="fechaDesde">
        </div>
        <div class="form-group">
            <label for="fechaHasta">Hasta la fecha:</label>
            <input type="date" id="fechaHasta">
        </div>
        <button class="btn-search" onclick="generarInforme()">📊 Generar Informe</button>
        <button class="btn-print" onclick="window.print()">🖨️ Imprimir</button>
    </div>

    <div id="mensajeEstado">Seleccioná las fechas y hacé clic en Generar Informe.</div>

    <!-- TABLA DE RESULTADOS -->
    <div class="tabla-container">
        <table id="tablaResultados">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Extintor N°</th>
                    <th>DPS</th>
                    <th>Tipo / Cap.</th>
                    <th>Marca</th>
                    <th>Venc. Carga</th>
                    <th>Venc. PH</th>
                    <th>Ubicación</th>
                </tr>
            </thead>
            <tbody id="cuerpoTabla">
                <!-- Se llena dinámicamente -->
            </tbody>
        </table>
    </div>
</div>

<script>
    // CREDENCIALES CONFIGURADAS CON SUPABASE
    const SUPABASE_URL = "https://cpgdqzrvtensoruahgxn.supabase.co";
    const SUPABASE_KEY = "sb_publishable_o529qydnYQpc1UBoqttXpQ_hfdLAWb9";
    const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    // TRADUCTOR DE FECHAS: AAAA-MM-DD a DD/MM/AAAA
    function formatearFechaWeb(fechaSQL) {
        if (!fechaSQL) return "-";
        let partes = fechaSQL.split("-");
        if (partes.length === 3) {
            return `${partes[2]}/${partes[1]}/${partes[0]}`;
        }
        return fechaSQL;
    }

    // CARGAR CLIENTES AL INICIAR
    window.addEventListener("load", async function() {
        const { data, error } = await _supabase
            .from('extintores')
            .select('cliente')
            .not('cliente', 'is', null);

        if (!error && data) {
            const clientesUnicos = [...new Set(data.map(item => item.cliente).filter(Boolean))].sort();
            let select = document.getElementById("filtroCliente");
            clientesUnicos.forEach(cliente => {
                let opt = document.createElement("option");
                opt.value = cliente;
                opt.textContent = cliente;
                select.appendChild(opt);
            });
        }

        // Sugerir por defecto el mes actual en los inputs de fecha
        const hoy = new Date();
        const anio = hoy.getFullYear();
        let mes = hoy.getMonth() + 1;
        let mesStr = mes < 10 ? '0' + mes : mes;
        
        // Desde el primer día del mes actual
        document.getElementById("fechaDesde").value = `${anio}-${mesStr}-01`;
        
        // Hasta el último día del mes actual (aproximado o dejamos libre)
        document.getElementById("fechaHasta").value = `${anio}-${mesStr}-31`;

        generarInforme();
    });

    // GENERAR INFORME FILTRADO POR RANGO DE FECHAS
    async function generarInforme() {
        const cliente = document.getElementById("filtroCliente").value.trim();
        const campoFecha = document.getElementById("tipoFecha").value; // 'vto_carga' o 'vto_prueb_hidr'
        const fechaDesde = document.getElementById("fechaDesde").value;
        const fechaHasta = document.getElementById("fechaHasta").value;
        
        const tbody = document.getElementById("cuerpoTabla");
        const mensaje = document.getElementById("mensajeEstado");

        if (!fechaDesde || !fechaHasta) {
            alert("Por favor, seleccioná ambas fechas (Desde y Hasta).");
            return;
        }

        mensaje.textContent = "Generando informe...";
        tbody.innerHTML = "";

        let query = _supabase.from('extintores').select('*');

        // Filtrar por cliente si se seleccionó uno
        if (cliente) {
            query = query.eq('cliente', cliente);
        }

        // Filtrar por el rango de fechas elegido (gte = mayor o igual, lte = menor o igual)
        query = query.gte(campoFecha, fechaDesde).lte(campoFecha, fechaHasta);

        // Ordenar por la fecha de vencimiento seleccionada (los más urgentes primero)
        query = query.order(campoFecha, { ascending: true });

        const { data, error } = await query.limit(500);

        if (error) {
            console.error("Error al generar informe:", error);
            mensaje.textContent = "Ocurrió un error al consultar la base de datos.";
            return;
        }

        if (data.length === 0) {
            mensaje.textContent = "No se encontraron extintores que vencerán en ese rango de fechas.";
            return;
        }

        mensaje.textContent = `Se encontraron ${data.length} extintores en el rango seleccionado.`;

        // Poblar la tabla
        data.forEach(ex => {
            let tr = document.createElement("tr");

            let formatoDps = ex.numero_dps;
            if (formatoDps === "NUEVO") {
                formatoDps = `<span class="badge badge-nuevo">NUEVO</span>`;
            }

            tr.innerHTML = `
                <td><strong>${ex.cliente || "-"}</strong></td>
                <td>${ex.extintor_numero || "-"}</td>
                <td>${formatoDps || "-"}</td>
                <td>${ex.tipo || "-"} ${ex.capacidad ? `(${ex.capacidad})` : ""}</td>
                <td>${ex.marca || "-"}</td>
                <td>${formatearFechaWeb(ex.vto_carga)}</td>
                <td>${formatearFechaWeb(ex.vto_prueb_hidr)}</td>
                <td>${ex.identificacion_puesto || "-"} / ${ex.ubicacion || "-"}</td>
            `;
            tbody.appendChild(tr);
        });
    }
</script>

</body>
</html>
